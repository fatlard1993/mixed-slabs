{
  "schemaVersion": 1,
  "id": "mixed-slabs-justfatlard",
  "version": "${version}",
  "name": "Mixed Slabs",
  "description": "Two different slabs in one block space. Place any slab onto any other and they share the block instead of refusing each other.",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/mixed-slabs"
  },
  "license": "MIT",
  "icon": "assets/mixed-slabs-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.mixed_slabs.Main"
    ]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": "*"
  },
  "suggests": {
    "block-tip": "*"
  }
}
